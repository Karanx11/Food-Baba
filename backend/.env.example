# Copy to `.env` and fill in your key, then run `npm start`.
# A free key comes from https://aistudio.google.com/apikey

# Required: your Google AI Studio (Gemini) API key.
GEMINI_API_KEY=

# Optional: the vision model to call. Change if your key uses another one.
GEMINI_MODEL=gemini-3.6-flash

# Optional: the port the server listens on.
PORT=8787
